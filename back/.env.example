# Copia este archivo como back/.env (cp .env.example .env).
# Estos valores coinciden con la base de datos de docker-compose.yml.
DATABASE_URL=postgres://trendy:trendy@localhost:5433/trendy
DB_SSL=false
JWT_SECRET=trendy-local-dev-secret
PORT=3000
NODE_ENV=development
# Solo en desarrollo: sincroniza el esquema sin migraciones (déjalo en false).
DB_SYNCHRONIZE=false
